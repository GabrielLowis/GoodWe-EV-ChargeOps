# Variáveis lidas por backend/config.py (os valores abaixo já são os padrões).
# Exporte no terminal só o que mudar, por exemplo:
#   Linux/macOS: export DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/evchargeops
#   PowerShell:  $env:DATABASE_URL="postgresql+psycopg://usuario:senha@host:5432/evchargeops"
# Se o backend do grupo usar python-dotenv/pydantic-settings, um arquivo .env (fora do Git) também serve.

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/evchargeops
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/evchargeops_test

# Fuso do condomínio: as faixas tarifárias são avaliadas no horário local.
CONDO_TIMEZONE=America/Sao_Paulo

# Jurisdição usada para escolher as regras de imposto (tabela tax_rules).
TAX_JURISDICTION=BR-SP-SAO_PAULO
